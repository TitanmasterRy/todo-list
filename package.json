{
  "name": "homework-todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && npm run build:lite",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lite": "vite build --config vite.lite.config.ts && node scripts/fix-lite.mjs",
    "deploy:vercel": "npx vercel --prod",
    "deploy:netlify": "npm run build && npx netlify-cli deploy --prod --dir dist",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name homework-todo",
    "deploy:surge": "npm run build && npx surge dist",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "pack:extension": "node scripts/pack-extension.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "idb": "^8.0.3",
    "katex": "^0.16.47",
    "pdfjs-dist": "^6.3.289",
    "sql.js": "^1.14.2",
    "tesseract.js": "^7.0.0"
  }
}
