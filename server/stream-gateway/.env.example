# Names only: fill the values in on the server, never in git.

# argon2id hash of the sign-in password: docker exec -i stream-gateway node dist/cli.js hash-password
GATEWAY_PASSWORD_HASH=
# at least 32 random characters, e.g. openssl rand -base64 48
GATEWAY_SIGNING_KEY=
# coturn's static-auth-secret (use-auth-secret)
TURN_SECRET=
TURN_HOST=turn.levitica.duckdns.org
MW_URL=https://10.250.50.10:8443
# SHA-256 of MoonlightWeb's certificate, with or without colons:
# openssl s_client -connect 10.250.50.10:8443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
MW_CERT_SHA256=
# optional: the MoonlightWeb host uuid to stream (default: the first paired host)
MW_HOST_ID=
ALLOWED_ORIGIN=https://titanmasterry.github.io
