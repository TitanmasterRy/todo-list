# Replit: Import from GitHub, then press Run for the dev server, or Deploy → Static.
run = "npm install && npm run dev -- --host 0.0.0.0 --port 5173"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5173
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm ci && npm run build"]
publicDir = "dist"
